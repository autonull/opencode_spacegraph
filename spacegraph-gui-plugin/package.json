{
  "name": "@spacegraph/gui-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "Third-party OpenCode GUI plugin contributing SpaceGraph session surfaces.",
  "license": "MIT",
  "main": "./dist/gui-experimental.cjs",
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun node_modules/vite/bin/vite.js build",
    "typecheck": "tsc --noEmit",
    "test": "bun --conditions=browser test ./test/",
    "test:components": "bun --conditions=browser test ./test/components.test.ts",
    "test:model": "bun --conditions=browser test ./src/model/",
    "test:canvas": "bun --conditions=browser test ./src/host/canvas/",
    "test:plugin": "bun --conditions=browser test ./src/plugin/",
    "test:ui": "bun --conditions=browser test ./src/host/ui/",
    "test:host": "bun --conditions=browser test ./src/host/widget-registry.test.ts",
    "test:chrome": "bun --conditions=browser test ./src/host/chrome-helpers.test.ts",
    "test:model-plugin": "bun --conditions=browser test ./src/plugin/model.test.ts",
    "test:widgets": "bun --conditions=browser test ./src/host/widgets/"
  },
  "peerDependencies": {
    "@opencode/plugin": "*",
    "effect": "*",
    "solid-js": "^1.9.0"
  },
  "dependencies": {
    "@spacegraphjs/adapter": "file:../spacegraphjs/packages/adapter",
    "@spacegraphjs/kernel": "file:../spacegraphjs/packages/kernel",
    "@spacegraphjs/config": "file:../spacegraphjs/packages/config",
    "@spacegraphjs/cytoscape-renderer": "file:../spacegraphjs/packages/cytoscape-renderer",
    "@spacegraphjs/overlays": "file:../spacegraphjs/packages/overlays",
    "@spacegraphjs/renderer": "file:../spacegraphjs/packages/renderer",
    "@spacegraphjs/search": "file:../spacegraphjs/packages/search",
    "@spacegraphjs/spacegraph-renderer": "file:../spacegraphjs/packages/spacegraph-renderer",
    "@spacegraphjs/svg-renderer": "file:../spacegraphjs/packages/svg-renderer",
    "@spacegraphjs/shared": "file:../spacegraphjs/packages/shared",
    "@spacegraphjs/trace": "file:../spacegraphjs/packages/trace",
    "@spacegraphjs/window-manager": "file:../spacegraphjs/packages/window-manager",
    "cytoscape": "^3.34.1",
    "spacegraphjs": "file:../spacegraphjs",
    "strip-ansi": "^7.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.0.11",
    "happy-dom": "20.11.1",
    "@opencode/client": "file:../packages/client",
    "@opencode/plugin": "file:../packages/plugin",
    "@opencode/ui": "file:../packages/ui",
    "@types/bun": "*",
    "effect": "*",
    "solid-js": "*",
    "typescript": "*",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16"
  }
}
