{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpaceGraph Capture Overrides",
  "type": "object",
  "required": ["overrides"],
  "properties": {
    "overrides": {
      "type": "object",
      "patternProperties": {
        "^[0-9]{2}-graph-.+\\.png$": {
          "type": "object",
          "required": ["owner", "reason", "maxDiffPercent"],
          "properties": {
            "owner": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 },
            "maxDiffPercent": { "type": "number", "minimum": 0, "maximum": 100 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}